# ---- Canteen Pre-Order Management System :: backend config ----
# Copy to `.env` and adjust.  `cp .env.example .env`

# HTTP port for the REST API + static frontend
PORT=4000

# SQLite database file (created automatically)
DB_PATH=./data/canteen.db

# HMAC secret used to sign access tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime in seconds (default 7 days)
TOKEN_TTL_SECONDS=604800

# Service/platform fee added to every order, in percent (0 disables it)
SERVICE_FEE_PERCENT=0

# CORS origin for the dev frontend ("*" allows any origin)
CORS_ORIGIN=*

# ---- Demo accounts created by `npm run seed` ----
SEED_ADMIN_EMAIL=admin@canteen.test
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_EMAIL=staff@canteen.test
SEED_STAFF_PASSWORD=Staff@123
SEED_STUDENT_EMAIL=student@canteen.test
SEED_STUDENT_PASSWORD=Student@123
